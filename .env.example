# Copie para app/.env.local e preencha com os dados do projeto Firebase (Console > Configurações do projeto > Seus apps > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL pública do app (usada para montar o link do orçamento: {VITE_APP_URL}/o/{id})
VITE_APP_URL=https://orca-ja-app.pages.dev

# Limite do plano grátis (orçamentos enviados por mês)
VITE_LIMITE_FREE=3

# "true" para o app usar os emuladores locais (firebase emulators:start) em vez do projeto real
VITE_USAR_EMULADOR=false

# Contato do suporte mostrado na tela Ajuda (opcionais). WhatsApp só com dígitos e 55 na frente.
VITE_SUPORTE_WHATSAPP=
VITE_SUPORTE_EMAIL=
