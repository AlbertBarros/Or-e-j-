rules_version = '2';
// Preço Fechado — regras do Firestore
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Teste grátis do Pro: 14 dias, uma única vez por conta. planoAte == testeProAte; folga de 1 dia para relógio errado no celular.
    function testeProValido(d) {
      return d.plano == "pro"
        && d.planoAte is timestamp
        && d.testeProAte == d.planoAte
        && d.planoAte > request.time
        && d.planoAte <= request.time + duration.value(15 * 24 * 60, "m");
    }

    // Perfil do profissional. "plano" e "planoAte" só o servidor altera (webhook / script),
    // com uma exceção: ligar o teste de 14 dias do Pro, uma vez.
    match /users/{uid} {
      allow read: if dono(uid);
      allow create: if dono(uid)
        && (request.resource.data.plano == "free" || testeProValido(request.resource.data));
      allow update: if dono(uid) && (
        !mudou().hasAny(["plano", "planoAte", "testeProAte", "assinatura"])
        ||
        (!("testeProAte" in resource.data)
          && (resource.data.plano == "free" || !("planoAte" in resource.data) || resource.data.planoAte < request.time)
          && mudou().hasOnly(["plano", "planoAte", "testeProAte"])
          && testeProValido(request.resource.data))
      );
      allow delete: if false;
    }

    // Aparelhos inscritos para receber avisos (Web Push). O id é o hash do endereço do aparelho.
    match /push/{id} {
      allow get: if logado() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if logado() && resource.data.ownerId == request.auth.uid;
      allow create, update: if logado()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId", "endpoint", "chaves", "aparelho", "criadoEm"])
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() < 1000
        && request.resource.data.endpoint.matches("https://.*");
      allow delete: if logado() && resource.data.ownerId == request.auth.uid;
    }

    // Mensagens para o suporte: o profissional só cria; quem lê é o dono do sistema, no console.
    match /suporte/{id} {
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "nome", "negocio", "email", "whatsapp", "assunto", "mensagem", "aparelho", "criadoEm"])
        && request.resource.data.mensagem is string
        && request.resource.data.mensagem.size() > 0
        && request.resource.data.mensagem.size() < 3000;
      allow read, update, delete: if false;
    }

    // Depoimentos: o profissional escreve o seu (sempre como não publicado); o dono do sistema publica no console.
    // O site lê só os publicados.
    match /depoimentos/{uid} {
      allow read: if resource.data.publicado == true || dono(uid);
      allow create, update: if dono(uid)
        && request.resource.data.publicado == false
        && request.resource.data.keys().hasOnly(["nome", "negocio", "profissao", "cidade", "nota", "texto", "publicado", "criadoEm", "atualizadoEm"])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 10
        && request.resource.data.texto.size() <= 600
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5;
      allow delete: if dono(uid);
    }

    // Catálogo de produtos e serviços: só o dono.
    match /users/{uid}/catalogo/{itemId} {
      allow read, write: if dono(uid);
    }

    // Banco de clientes: só o dono lê e escreve os seus.
    match /clientes/{id} {
      // get de documento inexistente devolve "não existe" (resource == null) em vez de erro
      allow get: if logado() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if logado() && resource.data.ownerId == request.auth.uid;
      allow create: if logado() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if logado() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // Contratos: link público lê um; o cliente (sem login) só assina um contrato enviado.
    match /contratos/{id} {
      allow get: if true;
      allow list: if logado() && resource.data.ownerId == request.auth.uid;
      allow create: if logado() && request.resource.data.ownerId == request.auth.uid;
      allow update: if
        (logado() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        ||
        (resource.data.status == "enviado"
          && request.resource.data.status == "assinado"
          && mudou().hasOnly(["status", "assinatura", "atualizadoEm"])
          && request.resource.data.assinatura.nome is string
          && request.resource.data.assinatura.imagem is string
          && request.resource.data.assinatura.imagem.size() < 80000);
      allow delete: if logado() && resource.data.ownerId == request.auth.uid;
    }

    // Cartão de visita virtual: leitura pública, escrita só do dono.
    match /cartoes/{uid} {
      allow read: if true;
      allow write: if dono(uid);
    }

    // Logo do profissional (data URL comprimida no navegador, até ~100 KB).
    // Leitura pública: a página do orçamento mostra a logo sem ler users/.
    match /logos/{uid} {
      allow read: if true;
      allow write: if dono(uid)
        && request.resource.data.keys().hasOnly(["dataUrl", "atualizadoEm"])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 140000
        && request.resource.data.dataUrl.matches('data:image/.*');
      allow delete: if dono(uid);
    }

    // Orçamentos. O id é aleatório e longo: o link público é "não adivinhável".
    match /orcamentos/{id} {
      // Qualquer pessoa com o link lê UM documento; ninguém lista orçamentos alheios.
      allow get: if true;
      allow list: if logado() && resource.data.ownerId == request.auth.uid;

      allow create: if logado()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ["rascunho", "enviado"];

      allow update: if
        // O dono altera tudo, menos o dono.
        (logado() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        ||
        // O cliente (sem login) só aprova ou recusa um orçamento enviado.
        (resource.data.status == "enviado"
          && request.resource.data.status in ["aprovado", "recusado"]
          && mudou().hasOnly(["status", "respondidoEm"]));

      allow delete: if logado() && resource.data.ownerId == request.auth.uid;
    }

    // Métricas (PRD): só criação, sem dados pessoais; ninguém lê pelo cliente.
    match /eventos/{id} {
      allow create: if request.resource.data.keys().hasOnly(["nome", "uid", "orcamentoId", "origem", "criadoEm"])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() < 60;
      allow read, update, delete: if false;
    }

    // Lista de espera vinda do site de SEO: só criação, ninguém lê pelo cliente.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(["email", "whatsapp", "profissao", "origem", "criadoEm"])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 120;
      allow read, update, delete: if false;
    }
  }
}
