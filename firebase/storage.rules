rules_version = '2';
// Orça Já — logos dos profissionais (leitura pública, escrita só do dono, até 1 MB, só imagem)
service firebase.storage {
  match /b/{bucket}/o {
    match /logos/{uid}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
