---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta";
import Telefone from "../components/Telefone.astro";
import Recursos from "../components/Recursos.astro";
import Planos from "../components/Planos.astro";
import Faq from "../components/Faq.astro";
import { profissoes, urlProfissao } from "../lib/profissoes";
import { NOME_SITE, URL_HUB } from "../lib/site";
import { APP_PRONTO, URL_CADASTRO, LIMITE_FREE, textoMensal, textoAnualPorMes } from "../lib/planos";

const titulo = "Orça Fácil — orçamento profissional, aprovação por link, contrato assinado e Pix";
const descricao =
  "Monte o orçamento no celular em 1 minuto, envie pelo WhatsApp, receba a aprovação por link, o contrato assinado e o Pix. Clientes, recibos em PDF e cartão de visita. Grátis para começar.";

const opcoes = profissoes.map((p) => ({ slug: p.slug, nome: p.nome }));

const passos = [
  { n: 1, t: "Monte o orçamento em 1 minuto", d: "Escolha o cliente, toque nos serviços do seu catálogo e, se precisar, adicione o frete calculado pelo mapa. O total aparece ao vivo.", tela: "novo", alt: "Tela de novo orçamento do app" },
  { n: 2, t: "Escolha o modelo e veja a prévia", d: "Simples, Detalhado ou Completo, com sua logo. Você vê exatamente como o cliente vai receber antes de tocar em Enviar.", tela: "previa", alt: "Prévia do orçamento em moldura de celular" },
  { n: 3, t: "O cliente aprova e paga pelo Pix", d: "Ele abre o link no WhatsApp, toca em Aprovar e o QR Code do Pix aparece na mesma página. Você recebe a notificação.", tela: "aprovado", alt: "Página do cliente com carimbo de aprovado" },
  { n: 4, t: "Contrato assinado e recibo", d: "O app sugere o contrato já preenchido, o cliente assina pelo celular, e no fim o recibo em PDF sai com garantia e valor por extenso.", tela: "contrato-assinado", alt: "Contrato assinado pelo cliente" },
];

const faq = [
  { pergunta: "Meu cliente precisa baixar algum aplicativo?", resposta: "Não. Ele recebe um link pelo WhatsApp, abre no navegador do celular, vê o orçamento e aprova com um toque. Para o contrato, desenha a assinatura na tela. Nenhum cadastro é pedido a ele." },
  { pergunta: "O dinheiro passa pelo Orça Fácil?", resposta: "Nunca. O Pix é gerado com a sua chave e cai direto na sua conta. O Orça Fácil só organiza o orçamento, a aprovação, o contrato e o recibo." },
  { pergunta: "O contrato assinado pelo celular vale?", resposta: "A assinatura eletrônica simples tem validade legal no Brasil para contratos entre particulares (MP 2.200-2/2001). O app registra nome, data, hora e aparelho. O texto é um modelo sugerido: revise com um advogado se o seu caso for mais complexo." },
  { pergunta: "Preciso de CNPJ ou MEI?", resposta: "Não. Autônomo com CPF usa normalmente, inclusive o Pix. Se você tiver MEI, pode colocar o nome da empresa e o CNPJ nos documentos." },
  { pergunta: "O plano grátis é grátis mesmo?", resposta: `Sim. Você envia até ${LIMITE_FREE} orçamentos por mês, com link de aprovação, contratos, clientes e cobrança, sem cartão de crédito. O Pix na aprovação, o recibo em PDF, a logo e a retirada da nossa marca ficam para o Pro.` },
  { pergunta: "Funciona no meu celular?", resposta: "Funciona em qualquer celular com navegador, Android ou iPhone, e também no computador. Dá para instalar na tela inicial como um app." },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Organization", name: NOME_SITE, url: new URL("/", Astro.site).href, logo: new URL("/logo.svg", Astro.site).href },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: NOME_SITE,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: new URL("/", Astro.site).href,
    description: descricao,
    inLanguage: "pt-BR",
    offers: [
      { "@type": "Offer", name: "Grátis", price: "0", priceCurrency: "BRL" },
      { "@type": "Offer", name: "Pro mensal", price: "29.90", priceCurrency: "BRL" },
      { "@type": "Offer", name: "Pro anual", price: "238.80", priceCurrency: "BRL" },
    ],
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.pergunta, acceptedAnswer: { "@type": "Answer", text: f.resposta } })) },
];
---

<Base titulo={titulo} descricao={descricao} caminho="/" jsonLd={jsonLd} largura="larga">
  <!-- Herói -->
  <section class="relative grid items-center gap-10 pt-10 sm:pt-14 lg:grid-cols-[1.05fr_1fr] lg:gap-6 lg:pt-16">
    <div class="revelar visivel">
      <p class="inline-flex items-center gap-2 rounded-full border border-pauta bg-folha px-3 py-1 text-sm font-medium text-carbono shadow-sm">
        <span class="h-2 w-2 rounded-full bg-pago" aria-hidden="true"></span>
        Novo: contratos com assinatura pelo celular
      </p>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl lg:text-[3.6rem]">
        Orçamento com cara de empresa.
        <span class="texto-gradiente">Aprovação, contrato e Pix em um link.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-grafite">
        Monte o orçamento no celular em 1 minuto, envie pelo WhatsApp e acompanhe tudo: o cliente aprova, assina o contrato e paga no Pix. Clientes, recibos em PDF e cartão de visita no mesmo app.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <Cta client:load variante="primario" texto="Começar grátis" href={APP_PRONTO ? URL_CADASTRO : undefined} origem="home:heroi" titulo="Comece grátis assim que o app abrir" opcoesProfissao={opcoes} className="!min-h-12 !px-7 text-base shadow-[0_12px_30px_-12px_rgba(30,58,138,0.6)]" />
        <a href="/como-funciona" class="botao-secundario !min-h-12 !px-7 text-base">Ver como funciona</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-grafite">
        <li class="flex items-center gap-1.5"><span class="text-pago" aria-hidden="true">✓</span> {LIMITE_FREE} orçamentos grátis por mês</li>
        <li class="flex items-center gap-1.5"><span class="text-pago" aria-hidden="true">✓</span> Sem cartão de crédito</li>
        <li class="flex items-center gap-1.5"><span class="text-pago" aria-hidden="true">✓</span> O cliente não precisa de app</li>
      </ul>
    </div>
    <div class="relative mx-auto flex w-full max-w-[520px] items-end justify-center gap-4 px-2 pt-6 lg:pt-0">
      <Telefone tela="inicio" alt="Tela inicial do app com totais, pendências e gráficos" largura={290} flutuar prioridade />
      <div class="hidden w-[200px] shrink-0 sm:block">
        <Telefone tela="aprovado" alt="Página do cliente com o orçamento aprovado" largura={200} mancha={false} class="flutuar-2 translate-y-10" />
      </div>
    </div>
  </section>

  <!-- Faixa de profissões -->
  <section aria-label="Profissões atendidas" class="revelar mt-16">
    <p class="text-center text-sm text-grafite">Com itens prontos para</p>
    <ul class="mt-3 flex flex-wrap justify-center gap-2">
      {profissoes.map((p) => (
        <li><a href={urlProfissao(p.slug)} class="chip hover:border-carbono hover:text-carbono">{p.nome}</a></li>
      ))}
    </ul>
  </section>

  <!-- Como funciona (4 passos com telas reais) -->
  <section id="como-funciona" aria-labelledby="cf-titulo" class="mt-24 scroll-mt-24">
    <div class="revelar text-center">
      <p class="titulo-secao">Como funciona</p>
      <h2 id="cf-titulo" class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Do orçamento ao recibo em 4 passos</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-grafite">Tudo no seu celular. O cliente só precisa do WhatsApp.</p>
    </div>
    <ol class="mt-12 space-y-20">
      {passos.map((p, i) => (
        <li class={`revelar grid items-center gap-8 lg:grid-cols-2 lg:gap-16 ${i % 2 === 1 ? "lg:[&>*:first-child]:order-2" : ""}`}>
          <div class="mx-auto w-full max-w-[300px]">
            <Telefone tela={p.tela} alt={p.alt} largura={280} />
          </div>
          <div>
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-carbono text-lg font-bold text-white">{p.n}</span>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[0.18em] text-carbono">Passo {p.n}</p>
            <h3 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">{p.t}</h3>
            <p class="mt-3 max-w-md text-lg text-grafite">{p.d}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="revelar mt-12 text-center">
      <a href="/como-funciona" class="botao-secundario !min-h-12 !px-7 text-base">Ver o tour interativo e todas as funcionalidades →</a>
    </div>
  </section>

  <!-- Recursos -->
  <section id="recursos" aria-labelledby="rec-titulo" class="mt-24 scroll-mt-24">
    <div class="revelar text-center">
      <p class="titulo-secao">Recursos</p>
      <h2 id="rec-titulo" class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Tudo o que você precisa, nada do que atrapalha</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-grafite">Sem agenda, sem estoque, sem relatório complicado. Só o que faz o orçamento virar dinheiro na conta.</p>
    </div>
    <div class="mt-10">
      <Recursos />
    </div>
    <p class="revelar mt-6 text-center">
      <a href="/como-funciona#funcionalidades" class="font-semibold text-carbono hover:underline">Ver a lista completa de funcionalidades →</a>
    </p>
  </section>

  <!-- Galeria -->
  <section aria-labelledby="gal-titulo" class="mt-24">
    <div class="revelar text-center">
      <p class="titulo-secao">Por dentro do app</p>
      <h2 id="gal-titulo" class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Bonito para você, claro para o cliente</h2>
    </div>
    <div class="revelar -mx-4 mt-10 overflow-x-auto px-4 pb-4 [scrollbar-width:thin]">
      <ul class="flex w-max gap-6 pt-6">
        {[
          ["orcamentos", "Lista de orçamentos com status"],
          ["detalhe", "Detalhe do orçamento com frete e dois valores"],
          ["clientes", "Banco de clientes"],
          ["contratos", "Contratos assinados e pendentes"],
          ["pix", "Pix na página de aprovação"],
          ["cartao", "Cartão de visita virtual"],
        ].map(([tela = "", alt = ""]) => (
          <li class="w-[220px] shrink-0">
            <Telefone tela={tela} alt={alt} largura={220} mancha={false} />
            <p class="mt-3 text-center text-sm text-grafite">{alt}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Conta rápida -->
  <section aria-labelledby="conta-titulo" class="revelar mt-24 overflow-hidden rounded-3xl bg-gradient-to-br from-carbono to-[#2B4FB8] px-6 py-12 text-white sm:px-12">
    <h2 id="conta-titulo" class="text-3xl font-extrabold tracking-tight sm:text-4xl">Faça a conta</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <div>
        <p class="tabular text-5xl font-extrabold">1</p>
        <p class="mt-2 text-white/80">orçamento aprovado a mais no mês já paga o Pro inteiro, várias vezes.</p>
      </div>
      <div>
        <p class="tabular text-5xl font-extrabold">{textoAnualPorMes}</p>
        <p class="mt-2 text-white/80">por mês no plano anual. Menos do que um almoço, pelo mês todo de orçamentos.</p>
      </div>
      <div>
        <p class="tabular text-5xl font-extrabold">0</p>
        <p class="mt-2 text-white/80">taxas sobre o que você recebe. O Pix é seu, direto na sua conta.</p>
      </div>
    </div>
  </section>

  <!-- Planos -->
  <section id="precos" aria-labelledby="planos-titulo" class="mt-24 scroll-mt-24">
    <div class="revelar text-center">
      <p class="titulo-secao">Planos</p>
      <h2 id="planos-titulo" class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Comece grátis. Cresça quando fizer sentido.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-grafite">
        O grátis já resolve orçamento, aprovação, contratos e clientes. O Pro tira o limite e libera Pix na aprovação, recibo em PDF e sua marca, por {textoMensal} ao mês ou {textoAnualPorMes} por mês no anual.
      </p>
    </div>
    <div class="revelar mt-10">
      <Planos origem="home" />
    </div>
  </section>

  <!-- Perguntas -->
  <div id="perguntas" class="revelar scroll-mt-24">
    <Faq perguntas={faq} titulo="Perguntas antes de começar" />
  </div>

  <!-- Chamada final -->
  <section aria-labelledby="final-titulo" class="revelar cartao mt-24 px-6 py-12 text-center sm:px-10">
    <h2 id="final-titulo" class="text-3xl font-extrabold tracking-tight sm:text-4xl">Seu próximo orçamento pode ser o primeiro com cara de empresa.</h2>
    <p class="mx-auto mt-3 max-w-xl text-lg text-grafite">Leva 2 minutos para configurar: profissão, nome do negócio, serviços e chave Pix. Depois, cada orçamento leva 1.</p>
    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <Cta client:visible variante="primario" texto="Começar grátis" href={APP_PRONTO ? URL_CADASTRO : undefined} origem="home:final" titulo="Comece grátis assim que o app abrir" opcoesProfissao={opcoes} className="!min-h-12 !px-7 text-base" />
      <a href={URL_HUB} class="botao-secundario !min-h-12 !px-7 text-base">Testar um modelo sem cadastro</a>
    </div>
  </section>
</Base>
