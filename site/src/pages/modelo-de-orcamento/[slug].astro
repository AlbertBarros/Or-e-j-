---
import Base from "../../layouts/Base.astro";
import Gerador from "../../components/Gerador";
import Documento from "../../components/Documento.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta";
import { profissoes, relacionadas, urlProfissao, type Profissao } from "../../lib/profissoes";
import { NOME_SITE, URL_HUB } from "../../lib/site";
import { APP_PRONTO, URL_CADASTRO, LIMITE_FREE } from "../../lib/planos";

export function getStaticPaths() {
  return profissoes.map((p) => ({ params: { slug: p.slug }, props: { profissao: p } }));
}

interface Props {
  profissao: Profissao;
}
const { profissao } = Astro.props;
const caminho = urlProfissao(profissao.slug);
const urlAbsoluta = new URL(caminho, Astro.site).href;
const outras = relacionadas(profissao.slug);
const paragrafos = profissao.comoPreencher ?? [];
const opcoes = profissoes.map((p) => ({ slug: p.slug, nome: p.nome }));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Modelos de orçamento", item: new URL(URL_HUB, Astro.site).href },
      { "@type": "ListItem", position: 3, name: profissao.nome, item: urlAbsoluta },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: `${NOME_SITE} — gerador de orçamento para ${profissao.nome.toLowerCase()}`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: urlAbsoluta,
    description: profissao.seo.descricao,
    inLanguage: "pt-BR",
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: profissao.faq.map((f) => ({
      "@type": "Question",
      name: f.pergunta,
      acceptedAnswer: { "@type": "Answer", text: f.resposta },
    })),
  },
];
---

<Base titulo={profissao.seo.titulo} descricao={profissao.seo.descricao} caminho={caminho} jsonLd={jsonLd}>
  <nav aria-label="Você está em" class="pt-4 text-sm text-grafite">
    <ol class="flex flex-wrap gap-1">
      <li><a href="/" class="hover:text-carbono">Início</a> ›</li>
      <li><a href={URL_HUB} class="hover:text-carbono">Modelos de orçamento</a> ›</li>
      <li aria-current="page" class="text-tinta">{profissao.nome}</li>
    </ol>
  </nav>

  <h1 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl">{profissao.seo.h1}</h1>
  <p class="mt-2 text-lg text-grafite">Preencha, baixe em PDF ou envie pelo WhatsApp. Grátis, sem cadastro.</p>

  <div class="mt-6">
    <Gerador client:visible profissao={{
      slug: profissao.slug,
      nome: profissao.nome,
      itens: profissao.itens,
      observacoesPadrao: profissao.observacoesPadrao,
      validadeDiasPadrao: profissao.validadeDiasPadrao,
    }} />
  </div>

  {
    paragrafos.length > 0 && (
      <section aria-labelledby="como-titulo" class="mt-12">
        <h2 id="como-titulo" class="text-2xl font-semibold">
          Como preencher o orçamento de {profissao.nome.toLowerCase()}
        </h2>
        <div class="mt-4 space-y-4 text-[17px] leading-relaxed">
          {paragrafos.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    )
  }

  <section aria-labelledby="exemplo-titulo" class="mt-12">
    <h2 id="exemplo-titulo" class="text-2xl font-semibold">Como fica o orçamento pronto</h2>
    <p class="mt-2 mb-4 text-grafite">
      Um exemplo com os itens mais comuns de {profissao.plural}. No gerador acima você troca tudo: itens, valores e
      observações.
    </p>
    <Documento profissao={profissao} />
  </section>

  <Faq perguntas={profissao.faq} />

  <section aria-labelledby="cta-titulo" class="mt-12 rounded-lg border border-pauta bg-folha p-5">
    <h2 id="cta-titulo" class="text-xl font-semibold">Cansou de orçamento no papel ou em mensagem solta?</h2>
    <p class="mt-2 text-grafite">
      Com o Orça Já você manda o orçamento por um link, o cliente aprova com um toque e paga por Pix. Depois, o recibo
      sai em PDF. Grátis para começar, com {LIMITE_FREE} orçamentos por mês.
    </p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row">
      <Cta
        client:visible
        variante="primario"
        texto="Começar grátis"
        href={APP_PRONTO ? URL_CADASTRO : undefined}
        origem={`site:${profissao.slug}:cta`}
        titulo="Comece grátis assim que o app abrir"
        opcoesProfissao={opcoes}
      />
      <a href="/precos" class="botao-secundario">Ver planos e preços</a>
    </div>
  </section>

  <section aria-labelledby="rel-titulo" class="mt-12">
    <h2 id="rel-titulo" class="text-xl font-semibold">Outros modelos de orçamento</h2>
    <ul class="mt-3 divide-y divide-pauta rounded-lg border border-pauta bg-folha">
      {
        outras.map((o) => (
          <li>
            <a href={urlProfissao(o.slug)} class="flex min-h-11 items-center justify-between px-4 py-3 hover:bg-carbono-claro">
              <span>Modelo de orçamento para {o.nome.toLowerCase()}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={URL_HUB} class="flex min-h-11 items-center px-4 py-3 text-carbono hover:bg-carbono-claro">
          Ver todas as profissões
        </a>
      </li>
    </ul>
  </section>
</Base>
