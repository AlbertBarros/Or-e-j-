---
import Base from "../../layouts/Base.astro";
import Gerador from "../../components/Gerador";
import Documento from "../../components/Documento.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta";
import { profissoes, relacionadas, urlProfissao, type Profissao } from "../../lib/profissoes";
import { NOME_SITE, URL_HUB } from "../../lib/site";
import { APP_PRONTO, URL_CADASTRO, LIMITE_FREE } from "../../lib/planos";
import { iconeProfissao } from "../../lib/icones";

export function getStaticPaths() {
  return profissoes.map((p) => ({ params: { slug: p.slug }, props: { profissao: p } }));
}

interface Props {
  profissao: Profissao;
}
const { profissao } = Astro.props;
const caminho = urlProfissao(profissao.slug);
const urlAbsoluta = new URL(caminho, Astro.site).href;
const outras = relacionadas(profissao.slug);
const paragrafos = profissao.comoPreencher ?? [];
const opcoes = profissoes.map((p) => ({ slug: p.slug, nome: p.nome }));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Modelos de orçamento", item: new URL(URL_HUB, Astro.site).href },
      { "@type": "ListItem", position: 3, name: profissao.nome, item: urlAbsoluta },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: `${NOME_SITE} — gerador de orçamento para ${profissao.nome.toLowerCase()}`,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: urlAbsoluta,
    description: profissao.seo.descricao,
    inLanguage: "pt-BR",
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: profissao.faq.map((f) => ({
      "@type": "Question",
      name: f.pergunta,
      acceptedAnswer: { "@type": "Answer", text: f.resposta },
    })),
  },
];
---

<Base titulo={profissao.seo.titulo} descricao={profissao.seo.descricao} caminho={caminho} jsonLd={jsonLd} largura="larga">
  <nav aria-label="Você está em" class="pt-4 text-sm text-grafite">
    <ol class="flex flex-wrap gap-1">
      <li><a href="/" class="hover:text-carbono">Início</a> ›</li>
      <li><a href={URL_HUB} class="hover:text-carbono">Modelos de orçamento</a> ›</li>
      <li aria-current="page" class="text-tinta">{profissao.nome}</li>
    </ol>
  </nav>

  <header class="relative mt-6">
    <div class="fundo-grade pointer-events-none absolute -inset-x-10 -top-10 bottom-0 -z-10" aria-hidden="true"></div>
    <div class="flex items-center gap-4">
      <span class="icone-profissao !h-14 !w-14">
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={iconeProfissao(profissao.slug)} />
      </span>
      <div>
        <p class="titulo-secao">Modelo grátis · {profissao.itens.length} serviços prontos</p>
        <h1 class="mt-1 text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">{profissao.seo.h1}</h1>
      </div>
    </div>
    <p class="mt-4 max-w-2xl text-lg text-grafite">Preencha abaixo, baixe em PDF ou leve para o app e envie por link com aprovação. Grátis, sem cadastro.</p>
  </header>

  <div class="mt-8">
    <Gerador client:visible profissao={{
      slug: profissao.slug,
      nome: profissao.nome,
      itens: profissao.itens,
      observacoesPadrao: profissao.observacoesPadrao,
      validadeDiasPadrao: profissao.validadeDiasPadrao,
    }} />
  </div>

  {
    paragrafos.length > 0 && (
      <section aria-labelledby="como-titulo" class="revelar cartao mt-16 p-6 sm:p-8">
        <p class="titulo-secao">Guia rápido</p>
        <h2 id="como-titulo" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">
          Como preencher o orçamento de {profissao.nome.toLowerCase()}
        </h2>
        <div class="mt-4 max-w-3xl space-y-4 text-[17px] leading-relaxed">
          {paragrafos.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    )
  }

  <section aria-labelledby="exemplo-titulo" class="revelar mt-16">
    <p class="titulo-secao">Exemplo</p>
    <h2 id="exemplo-titulo" class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">Como fica o orçamento pronto</h2>
    <p class="mt-2 mb-6 max-w-2xl text-grafite">
      Um exemplo com os itens mais comuns de {profissao.plural}. No gerador acima você troca tudo: itens, valores e
      observações.
    </p>
    <Documento profissao={profissao} />
  </section>

  <Faq perguntas={profissao.faq} />

  <section aria-labelledby="cta-titulo" class="revelar mt-16 overflow-hidden rounded-3xl px-6 py-10 text-white sm:px-10" style="background: linear-gradient(120deg, #1E40AF 0%, #2563EB 55%, #10B981 140%)">
    <h2 id="cta-titulo" class="text-2xl font-extrabold tracking-tight sm:text-3xl">Cansou de orçamento no papel ou em mensagem solta?</h2>
    <p class="mt-2 max-w-2xl text-white/85">
      Com o Preço Fechado você manda o orçamento por um link, o cliente aprova com um toque e paga por Pix. Depois, o recibo
      sai em PDF. Grátis para começar, com {LIMITE_FREE} orçamentos por mês.
    </p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row">
      <Cta
        client:visible
        variante="primario"
        texto="Começar grátis"
        href={APP_PRONTO ? URL_CADASTRO : undefined}
        origem={`site:${profissao.slug}:cta`}
        titulo="Comece grátis assim que o app abrir"
        opcoesProfissao={opcoes}
      />
      <a href="/precos" class="botao-secundario !rounded-xl">Ver planos e preços</a>
    </div>
  </section>

  <section aria-labelledby="rel-titulo" class="revelar mt-16">
    <h2 id="rel-titulo" class="text-2xl font-extrabold tracking-tight">Outros modelos de orçamento</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-3">
      {
        outras.map((o) => (
          <li>
            <a href={urlProfissao(o.slug)} class="cartao cartao-hover group flex items-center gap-3 p-4">
              <span class="icone-profissao !h-10 !w-10">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={iconeProfissao(o.slug)} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold">{o.nome}</span>
                <span class="block text-xs text-grafite">{o.itens.length} serviços prontos</span>
              </span>
              <span aria-hidden="true" class="text-carbono transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4">
      <a href={URL_HUB} class="font-semibold text-carbono hover:underline">Ver todas as profissões →</a>
    </p>
  </section>
</Base>
