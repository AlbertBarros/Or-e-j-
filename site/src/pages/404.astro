---
import Base from "../layouts/Base.astro";
import { URL_HUB } from "../lib/site";
---

<Base titulo="Página não encontrada | Orça Já" descricao="Essa página não existe." caminho="/404">
  <section class="pt-16 text-center">
    <p class="tabular text-6xl font-bold text-carbono">404</p>
    <h1 class="mt-3 text-2xl font-semibold">Essa página não existe.</h1>
    <p class="mt-2 text-grafite">O endereço pode ter mudado. Os modelos de orçamento continuam aqui:</p>
    <a href={URL_HUB} class="botao-primario mt-6">Ver modelos de orçamento</a>
  </section>
</Base>
