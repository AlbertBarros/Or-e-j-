---
import Cta from "./Cta";
import { profissoes } from "../lib/profissoes";
import {
  LIMITE_FREE,
  textoMensal,
  textoAnualPorMes,
  textoAnualTotal,
  textoEconomia,
  CHECKOUT_MENSAL,
  CHECKOUT_ANUAL,
  CHECKOUT_ANUAL_PIX,
  APP_PRONTO,
  URL_CADASTRO,
} from "../lib/planos";

interface Props {
  /** Prefixo da origem do lead, ex.: "home" ou "precos" */
  origem: string;
}
const { origem } = Astro.props;
const opcoes = profissoes.map((p) => ({ slug: p.slug, nome: p.nome }));

const recursosGratis = [
  `${LIMITE_FREE} orçamentos enviados por mês`,
  "Link de aprovação para o cliente",
  "Mensagens de cobrança prontas",
  "PDF do orçamento",
];
const recursosPro = [
  "Orçamentos ilimitados",
  "Pix copia-e-cola e QR Code na página de aprovação",
  "Recibo em PDF com sua logo e garantia do serviço",
  "Sua logo no orçamento",
  "Sem a marca \"Feito com Preço Fechado\"",
  "Tudo do plano grátis",
  "Cancele quando quiser",
];
---

<p class="revelar mx-auto mb-6 flex w-fit items-center gap-2 rounded-full border border-white/80 bg-white/70 px-4 py-2 text-sm font-semibold text-carbono shadow-sm backdrop-blur">
  <span aria-hidden="true">🎁</span> Toda conta nova começa com 14 dias de Pro grátis. Sem cartão.
</p>
<div class="grid gap-4 lg:grid-cols-3">
  <!-- Grátis -->
  <article class="cartao flex flex-col p-6">
    <h3 class="text-lg font-semibold">Grátis</h3>
    <p class="mt-1 text-sm text-grafite">Para testar com clientes de verdade.</p>
    <p class="mt-4 flex items-baseline gap-1">
      <span class="tabular text-4xl font-bold">R$ 0</span>
      <span class="text-grafite">para sempre</span>
    </p>
    <ul class="mt-5 flex-1 space-y-2 text-sm">
      {
        recursosGratis.map((r) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="mt-0.5 text-pago">✓</span>
            <span>{r}</span>
          </li>
        ))
      }
      <li class="flex gap-2 text-grafite">
        <span aria-hidden="true" class="mt-0.5">–</span>
        <span>Sem Pix na aprovação e sem recibo</span>
      </li>
      <li class="flex gap-2 text-grafite">
        <span aria-hidden="true" class="mt-0.5">–</span>
        <span>Sem logo; PDF com a marca Preço Fechado</span>
      </li>
    </ul>
    <Cta
      client:visible
      variante="secundario"
      texto="Começar grátis"
      href={APP_PRONTO ? URL_CADASTRO : undefined}
      origem={`${origem}:gratis`}
      titulo="Comece grátis assim que o app abrir"
      opcoesProfissao={opcoes}
      className="mt-6 w-full"
    />
    <p class="mt-2 text-center text-xs text-grafite">Sem cartão de crédito. Começa com 14 dias de Pro.</p>
  </article>

  <!-- Pro anual (destaque) -->
  <article class="cartao-destaque-plano relative flex flex-col rounded-2xl p-6">
    <span class="absolute -top-3 left-6 rounded-full bg-carbono px-3 py-1 text-xs font-semibold text-white">
      Mais escolhido · economize {textoEconomia}
    </span>
    <h3 class="text-lg font-semibold">Pro anual</h3>
    <p class="mt-1 text-sm text-grafite">Para quem já vive de orçamento.</p>
    <p class="mt-4 flex items-baseline gap-1">
      <span class="tabular text-4xl font-bold text-carbono">{textoAnualPorMes}</span>
      <span class="text-grafite">/mês</span>
    </p>
    <p class="text-sm text-grafite">{textoAnualTotal} cobrados uma vez por ano</p>
    <ul class="mt-5 flex-1 space-y-2 text-sm">
      {
        recursosPro.map((r) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="mt-0.5 text-pago">✓</span>
            <span>{r}</span>
          </li>
        ))
      }
    </ul>
    <Cta
      client:visible
      variante="primario"
      texto="Assinar no cartão"
      href={CHECKOUT_ANUAL || undefined}
      origem={`${origem}:pro-anual`}
      titulo="O Pro anual abre em breve: garanta seu lugar"
      opcoesProfissao={opcoes}
      className="mt-6 w-full"
    />
    <Cta
      client:visible
      variante="secundario"
      texto="Pagar com Pix"
      href={CHECKOUT_ANUAL_PIX || undefined}
      origem={`${origem}:pro-anual-pix`}
      titulo="O Pro anual abre em breve: garanta seu lugar"
      opcoesProfissao={opcoes}
      className="mt-2 w-full"
    />
    <p class="mt-2 text-center text-xs text-grafite">
      Cartão renova sozinho a cada ano. Pix é pagamento único de 12 meses. 7 dias de garantia.
    </p>
  </article>

  <!-- Pro mensal -->
  <article class="cartao flex flex-col p-6">
    <h3 class="text-lg font-semibold">Pro mensal</h3>
    <p class="mt-1 text-sm text-grafite">Sem compromisso, mês a mês.</p>
    <p class="mt-4 flex items-baseline gap-1">
      <span class="tabular text-4xl font-bold">{textoMensal}</span>
      <span class="text-grafite">/mês</span>
    </p>
    <p class="text-sm text-grafite">Renovação automática, cancele quando quiser</p>
    <ul class="mt-5 flex-1 space-y-2 text-sm">
      {
        recursosPro.map((r) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="mt-0.5 text-pago">✓</span>
            <span>{r}</span>
          </li>
        ))
      }
    </ul>
    <Cta
      client:visible
      variante="secundario"
      texto="Assinar o Pro mensal"
      href={CHECKOUT_MENSAL || undefined}
      origem={`${origem}:pro-mensal`}
      titulo="O Pro mensal abre em breve: garanta seu lugar"
      opcoesProfissao={opcoes}
      className="mt-6 w-full"
    />
    <p class="mt-2 text-center text-xs text-grafite">Cartão de crédito. 7 dias de garantia.</p>
  </article>
</div>
