---
/** Logo do Preço Fechado: etiqueta de preço com o check verde de "fechado" (mesmo desenho de scripts/gerar-marca.cjs). */
interface Props {
  tamanho?: number; // altura do símbolo em px
  comNome?: boolean;
  class?: string;
  claro?: boolean; // nome em branco (fundos escuros)
}
const { tamanho = 32, comNome = true, class: classe = "", claro = false } = Astro.props;
const fonte = Math.round(tamanho * 0.66);
const id = `pf-g-${Math.random().toString(36).slice(2, 7)}`;
---

<span class={`inline-flex items-center gap-2 ${classe}`}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width={tamanho} height={tamanho} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1E3A8A"></stop>
        <stop offset="1" stop-color="#2B4FB8"></stop>
      </linearGradient>
    </defs>
    <rect width="96" height="96" rx="22" fill={`url(#${id})`}></rect>
    <path d="M40 18 H70 a7 7 0 0 1 7 7 V55 a7 7 0 0 1 -7 7 H40 L17 40 Z" fill="#FFFFFF"></path>
    <circle cx="34" cy="40" r="4.5" fill="#1E3A8A"></circle>
    <rect x="46" y="31" width="22" height="4" rx="2" fill="#DCE4F7"></rect>
    <rect x="46" y="40" width="16" height="4" rx="2" fill="#DCE4F7"></rect>
    <rect x="46" y="49" width="20" height="5" rx="2.5" fill="#1E3A8A"></rect>
    <circle cx="66" cy="66" r="15" fill="#15803D" stroke="#FFFFFF" stroke-width="4"></circle>
    <path d="M59 66.5 L64 71.5 L73.5 61" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {
    comNome && (
      <span class={`whitespace-nowrap font-extrabold tracking-tight ${claro ? "text-white" : "text-tinta"}`} style={`font-size:${fonte}px;line-height:1`}>
        Preço <span class={claro ? "text-[#9DB4F0]" : "text-carbono"}>Fechado</span>
      </span>
    )
  }
</span>
