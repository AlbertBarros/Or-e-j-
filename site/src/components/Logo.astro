---
/** Logo do Orça Já: ícone em SVG inline + nome em texto (usa a fonte Archivo da página). */
interface Props {
  tamanho?: number; // altura do ícone em px
  comNome?: boolean;
  class?: string;
}
const { tamanho = 32, comNome = true, class: classe = "" } = Astro.props;
const fonte = Math.round(tamanho * 0.72);
---

<span class={`inline-flex items-center gap-2 ${classe}`}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 96 96"
    width={tamanho}
    height={tamanho}
    aria-hidden="true"
    focusable="false"
  >
    <rect x="22" y="18" width="56" height="70" rx="9" fill="#1E3A8A"></rect>
    <rect x="12" y="8" width="56" height="70" rx="9" fill="#FFFFFF" stroke="#1E3A8A" stroke-width="4"></rect>
    <line x1="24" y1="26" x2="56" y2="26" stroke="#DCE4F7" stroke-width="4" stroke-linecap="round"></line>
    <line x1="24" y1="38" x2="56" y2="38" stroke="#DCE4F7" stroke-width="4" stroke-linecap="round"></line>
    <line x1="24" y1="50" x2="44" y2="50" stroke="#DCE4F7" stroke-width="4" stroke-linecap="round"></line>
    <rect x="24" y="60" width="32" height="6" rx="3" fill="#1E3A8A"></rect>
    <circle cx="68" cy="70" r="16" fill="#15803D"></circle>
    <path d="M60 70.5 L65.5 76 L76 63.5" fill="none" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {
    comNome && (
      <span class="font-bold tracking-tight text-tinta" style={`font-size:${fonte}px;line-height:1`}>
        Orça <span class="text-carbono">Já</span>
      </span>
    )
  }
</span>
