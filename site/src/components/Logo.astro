---
/** Logo do Preço Fechado: balão de conversa com check (aprovado no WhatsApp) e selo R$. Mesmo desenho de scripts/gerar-marca.cjs. */
interface Props {
  tamanho?: number; // altura do símbolo em px
  comNome?: boolean;
  class?: string;
  claro?: boolean; // nome em branco (fundos escuros)
}
const { tamanho = 32, comNome = true, class: classe = "", claro = false } = Astro.props;
const fonte = Math.round(tamanho * 0.66);
const id = `pf-g-${Math.random().toString(36).slice(2, 7)}`;
---

<span class={`inline-flex items-center gap-2 ${classe}`}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width={tamanho} height={tamanho} aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1E40AF"></stop>
        <stop offset="0.55" stop-color="#2563EB"></stop>
        <stop offset="1" stop-color="#10B981"></stop>
      </linearGradient>
    </defs>
    <rect width="96" height="96" rx="22" fill={`url(#${id})`}></rect>
    <path d="M28 18 H68 a12 12 0 0 1 12 12 V50 a12 12 0 0 1 -12 12 H46 L32 76 V62 H28 a12 12 0 0 1 -12 -12 V30 a12 12 0 0 1 12 -12 Z" fill="#FFFFFF"></path>
    <path d="M34 41 L44 51 L63 30" fill="none" stroke="#16A34A" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="74" cy="22" r="9" fill="#16A34A" stroke="#FFFFFF" stroke-width="3"></circle>
    <text x="74" y="25.5" text-anchor="middle" font-family="Archivo, 'Segoe UI', Arial, sans-serif" font-weight="800" font-size="9" fill="#FFFFFF">R$</text>
  </svg>
  {
    comNome && (
      <span class={`whitespace-nowrap font-extrabold tracking-tight ${claro ? "text-white" : "text-tinta"}`} style={`font-size:${fonte}px;line-height:1`}>
        Preço <span class={claro ? "text-[#6EE7B7]" : "texto-marca"}>Fechado</span>
      </span>
    )
  }
</span>
