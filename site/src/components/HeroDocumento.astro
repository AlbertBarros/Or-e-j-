---
/** Visual do herói: um orçamento aprovado, em HTML puro, no estilo do talão em azul-carbono. */
import { formatarReais } from "@shared/src/mensagens";

const itens = [
  { d: "Troca de disjuntor", q: "2 un", v: 180 },
  { d: "Instalação de chuveiro elétrico", q: "1 un", v: 120 },
  { d: "Visita técnica / diagnóstico", q: "1 un", v: 80 },
];
const total = itens.reduce((s, i) => s + i.v, 0);
---

<div class="relative mx-auto w-full max-w-sm" aria-hidden="true">
  <!-- cópia carbono -->
  <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-lg bg-carbono"></div>
  <div class="documento relative overflow-hidden text-sm">
    <div class="flex items-start justify-between border-b border-pauta px-4 py-3">
      <div>
        <p class="font-semibold">JS Elétrica</p>
        <p class="text-xs text-grafite">Eletricista · (61) 99999-0000</p>
      </div>
      <div class="text-right">
        <p class="text-[10px] uppercase tracking-wide text-grafite">Orçamento</p>
        <p class="tabular text-lg font-bold text-carbono">Nº 0012</p>
      </div>
    </div>
    <div class="px-4 pt-3">
      <p class="text-xs text-grafite">Cliente</p>
      <p class="font-medium">Maria Souza</p>
    </div>
    <ul class="mt-2 divide-y divide-pauta border-t border-pauta">
      {
        itens.map((i) => (
          <li class="flex items-center justify-between gap-3 px-4 py-2">
            <span>
              {i.d}
              <span class="ml-1 text-xs text-grafite">{i.q}</span>
            </span>
            <span class="tabular font-medium">{formatarReais(i.v)}</span>
          </li>
        ))
      }
    </ul>
    <div class="flex items-baseline justify-between border-t-2 border-double border-tinta px-4 py-3">
      <span class="font-medium">Total</span>
      <span class="tabular text-2xl font-bold">{formatarReais(total)}</span>
    </div>
    <div class="flex items-center gap-2 border-t border-pauta bg-fundo px-4 py-2 text-xs text-grafite">
      <span class="inline-block h-2 w-2 rounded-full bg-pago"></span>
      Pix copia-e-cola liberado para o cliente
    </div>
    <!-- carimbo -->
    <div
      class="pointer-events-none absolute right-5 top-[42%] -rotate-12 rounded-md border-[3px] border-pago px-3 py-1 text-xl font-bold uppercase tracking-widest text-pago opacity-90"
    >
      Aprovado
    </div>
  </div>
</div>
