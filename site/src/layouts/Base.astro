---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Cta from "../components/Cta";
import { NOME_SITE, URL_HUB } from "../lib/site";
import { profissoes, urlProfissao } from "../lib/profissoes";
import { APP_PRONTO, URL_CADASTRO } from "../lib/planos";

interface Props {
  titulo: string;
  descricao: string;
  /** Caminho da página, ex.: "/modelo-de-orcamento/eletricista" */
  caminho: string;
  jsonLd?: object[];
  /** Imagem para redes sociais (caminho absoluto no site) */
  imagem?: string;
}

const { titulo, descricao, caminho, jsonLd = [], imagem = "/social.svg" } = Astro.props;
const canonical = new URL(caminho, Astro.site).href;
const imagemAbs = new URL(imagem, Astro.site).href;
const ano = new Date().getFullYear();
const opcoes = profissoes.map((p) => ({ slug: p.slug, nome: p.nome }));
const populares = profissoes.slice(0, 5);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1E3A8A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOME_SITE} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemAbs} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-screen bg-fundo text-tinta">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[10px] focus:bg-folha focus:px-4 focus:py-2"
    >
      Pular para o conteúdo
    </a>
    <header class="sticky top-0 z-40 border-b border-pauta bg-folha/95 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2">
        <a href="/" class="flex min-h-11 items-center" aria-label="Orça Já, página inicial">
          <Logo tamanho={32} />
        </a>
        <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
          <a href="/#como-funciona" class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-grafite hover:text-carbono">
            Como funciona
          </a>
          <a href="/precos" class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-grafite hover:text-carbono">
            Preços
          </a>
          <a href={URL_HUB} class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-grafite hover:text-carbono">
            Modelos grátis
          </a>
        </nav>
        <div class="flex items-center gap-1">
          <Cta
            client:idle
            variante="link"
            texto="Entrar"
            href={APP_PRONTO ? URL_CADASTRO : undefined}
            origem="menu:entrar"
            titulo="O acesso ao app está quase pronto"
            opcoesProfissao={opcoes}
          />
          <Cta
            client:idle
            variante="primario"
            texto="Começar grátis"
            href={APP_PRONTO ? URL_CADASTRO : undefined}
            origem="menu:comecar"
            titulo="Comece grátis assim que o app abrir"
            opcoesProfissao={opcoes}
            className="!min-h-10 !px-4 text-sm"
          />
        </div>
      </div>
    </header>

    <main id="conteudo" class="mx-auto w-full max-w-5xl px-4 pb-16">
      <slot />
    </main>

    <footer class="border-t border-pauta bg-folha">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3">
        <div>
          <Logo tamanho={28} />
          <p class="mt-3 max-w-xs text-sm text-grafite">
            Orçamento com cara de empresa, aprovação pelo WhatsApp e cobrança por Pix. Feito para quem trabalha por
            conta própria.
          </p>
        </div>
        <nav aria-label="Produto" class="text-sm">
          <p class="font-semibold">Produto</p>
          <ul class="mt-2 space-y-1">
            <li><a href="/#como-funciona" class="inline-flex min-h-9 items-center text-grafite hover:text-carbono">Como funciona</a></li>
            <li><a href="/precos" class="inline-flex min-h-9 items-center text-grafite hover:text-carbono">Preços</a></li>
            <li><a href={URL_HUB} class="inline-flex min-h-9 items-center text-grafite hover:text-carbono">Modelos de orçamento grátis</a></li>
            <li><a href="/#perguntas" class="inline-flex min-h-9 items-center text-grafite hover:text-carbono">Perguntas frequentes</a></li>
          </ul>
        </nav>
        <nav aria-label="Modelos populares" class="text-sm">
          <p class="font-semibold">Modelos populares</p>
          <ul class="mt-2 space-y-1">
            {
              populares.map((p) => (
                <li>
                  <a href={urlProfissao(p.slug)} class="inline-flex min-h-9 items-center text-grafite hover:text-carbono">
                    Orçamento para {p.nome.toLowerCase()}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="border-t border-pauta">
        <p class="mx-auto max-w-5xl px-4 py-4 text-xs text-grafite">© {ano} Orça Já. Todos os direitos reservados.</p>
      </div>
    </footer>
  </body>
</html>
