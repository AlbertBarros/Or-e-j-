# Copie para site/.env.local e preencha. No Cloudflare Pages, cadastre as mesmas variáveis no painel.
# Chaves públicas do app Web do Firebase (Console > Configurações do projeto > Seus apps > Web)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Endereço público do site (canonical, sitemap, JSON-LD)
SITE_URL=https://orca-ja-6cz.pages.dev

# Endereço do app (Fase 1+)
PUBLIC_APP_URL=https://orca-ja-app.pages.dev

# "true" quando o app estiver publicado: os botões "Começar grátis" e "Entrar" passam a levar ao app
PUBLIC_APP_PRONTO=true

# Links de checkout da plataforma de pagamento (Mercado Pago, Asaas...). Vazios = botão abre a lista de espera
PUBLIC_CHECKOUT_URL_MENSAL=https://mpago.la/1AxUgpG
PUBLIC_CHECKOUT_URL_ANUAL=https://mpago.la/1qdLoPa
